<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: the same rules as data_extraction_rules.xml. Each
     include only applies to device-to-device transfers. -->
<full-backup-content>
    <include
        domain="root"
        path="app_flutter/"
        requireFlags="deviceToDeviceTransfer" />
    <include
        domain="sharedpref"
        path="."
        requireFlags="deviceToDeviceTransfer" />
    <exclude
        domain="sharedpref"
        path="FlutterSecureStorage.xml" />
</full-backup-content>
