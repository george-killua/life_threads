<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Memories move to a new phone with device-to-device transfer
     (photos included, no size limit). Nothing goes to Google Drive backup:
     its 25 MB cap cannot hold the photos; the exported backup file is the
     full copy the user keeps. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- path_provider's documents directory: database and photos. -->
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
